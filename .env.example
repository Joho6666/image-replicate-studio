# Copy to .env.local and fill in. Environment variables override these values.

# OpenAI-compatible image relay (needs /v1/images/generations and /v1/images/edits)
IMAGE_API_BASE=https://your-relay.example.com/v1
IMAGE_API_KEY_GPT=sk-...
# Optional: key for grok-imagine-image models
IMAGE_API_KEY_GROK=
# Alternative: point at a keys.env containing JOHO_BASE_URL / JOHO_KEY_GPT / JOHO_KEY_GROK
# JOHO_KEYS=C:/path/to/keys.env

# TikHub, used to download Douyin cases
TIKHUB_API_KEY=
# TIKHUB_BASE_URL=https://api.tikhub.io

# ffmpeg executable (defaults to `ffmpeg` on PATH)
# FFMPEG=C:/ffmpeg/bin/ffmpeg.exe

# Local proxy used as a fallback for CDN downloads
# IRS_PROXY=http://127.0.0.1:7890
# IRS_PORT=3400
